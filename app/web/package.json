{
  "private": true,
  "name": "ai-github-radar-web",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "design:lint": "npx -y @google/design.md lint ../DESIGN.md",
    "design:export": "npx -y @google/design.md export --format tailwind ../DESIGN.md > app/assets/css/tokens.json",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/ui": "^4.0.0",
    "@iconify-json/lucide": "^1.2.0",
    "@pinia/nuxt": "^0.5.0",
    "nuxt": "^4.0.0",
    "pinia": "^2.2.0",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^3.14.0",
    "@playwright/test": "^1.45.0",
    "@vitest/coverage-v8": "^2.1.0",
    "happy-dom": "^15.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  }
}